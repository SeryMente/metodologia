<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EP Vault · v1.0.0"
        Width="1440" Height="900"
        MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#080B0D"
        Foreground="#C8D0CF"
        FontFamily="Bahnschrift"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <SolidColorBrush x:Key="VoidBrush" Color="#080B0D"/>
        <SolidColorBrush x:Key="CarbonBrush" Color="#0B1013"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#101619"/>
        <SolidColorBrush x:Key="BrassBrush" Color="#4D595D"/>
        <SolidColorBrush x:Key="BrassLightBrush" Color="#7F8D91"/>
        <SolidColorBrush x:Key="BoneBrush" Color="#C8D0CF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#7B8585"/>
        <SolidColorBrush x:Key="AmberBrush" Color="#B16E49"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#D0D6D5"/>
            <Setter Property="Background" Value="#1B2226"/>
            <Setter Property="BorderBrush" Value="#8B7048"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,11"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#283236"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#7F8D91"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#171D20"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0B1013"/>
            <Setter Property="Foreground" Value="#CDD4D3"/>
            <Setter Property="BorderBrush" Value="#5C5140"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="#A66D49"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#0B1013"/>
            <Setter Property="Foreground" Value="#CDD4D3"/>
            <Setter Property="BorderBrush" Value="#5C5140"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0B1013"/>
            <Setter Property="Foreground" Value="#CDD4D3"/>
            <Setter Property="BorderBrush" Value="#5C5140"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="ComboFrame" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="2"/>
                            <ContentPresenter Margin="10,0,34,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                                              ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                              RecognizesAccessKey="True"/>
                            <Path Data="M 0 0 L 6 6 L 12 0 Z" Fill="#7F8D91"
                                  Width="12" Height="6" Stretch="Fill"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,12,0"/>
                            <ToggleButton x:Name="DropDownToggle" Background="Transparent"
                                          BorderThickness="0" Focusable="False" Opacity="0"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#0B1013" BorderBrush="#4D595D" BorderThickness="1"
                                        MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType=Popup}}"
                                        MaxHeight="240">
                                    <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboFrame" Property="BorderBrush" Value="#7F8D91"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboFrame" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#C8D0CF"/>
            <Setter Property="Background" Value="#0B1013"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemFrame" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemFrame" Property="Background" Value="#303A40"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemFrame" Property="Background" Value="#222C30"/>
                                <Setter Property="Foreground" Value="#DCE1E0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemFrame" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListView">
            <Setter Property="Background" Value="#0B1013"/>
            <Setter Property="Foreground" Value="#C8D0CF"/>
            <Setter Property="BorderBrush" Value="#353D40"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style TargetType="{x:Type GridViewColumnHeader}">
            <Setter Property="Foreground" Value="#C8D0CF"/>
            <Setter Property="Background" Value="#1B2328"/>
            <Setter Property="BorderBrush" Value="#343F43"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                        <Border x:Name="HeaderFrame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HeaderFrame" Property="Background" Value="#263238"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="HeaderFrame" Property="Background" Value="#303A40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#9BA5A4"/>
            <Setter Property="Background" Value="#0B1013"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderBrush" Value="#3B4141"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabFrame" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabFrame" Property="Background" Value="#242D31"/>
                                <Setter TargetName="TabFrame" Property="BorderBrush" Value="#7F8D91"/>
                                <Setter Property="Foreground" Value="#DCE1E0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabFrame" Property="Background" Value="#1B252A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TabFrame" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30,22,30,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#30383B" BorderThickness="0,0,0,1" Padding="2,0,2,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="EP" FontFamily="Constantia" FontSize="26" Foreground="#7F8D91" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ENVIRONMENT VAULT" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="CÁMARA DE CUSTODIA LOCAL" FontSize="10" Foreground="#7B8585" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="SoundToggle" Content="SONIDO" IsChecked="True" Foreground="#9AA3A2" FontSize="9" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Ellipse Width="7" Height="7" Fill="#4D595D" Margin="0,0,8,0"/>
                    <TextBlock x:Name="HeaderState" Text="SELLADA" FontSize="11" Foreground="#7F8D91"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="ClosedStage" Grid.Row="1" Margin="0,18,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="390"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" ClipToBounds="True">
                <Ellipse Width="720" Height="720" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Fill="#090E11" Stroke="#303A3E" StrokeThickness="1">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="54" ShadowDepth="0" Opacity="0.8"/>
                    </Ellipse.Effect>
                </Ellipse>
                <Viewbox Stretch="Uniform" MaxWidth="670" MaxHeight="670" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewport3D x:Name="VaultViewport" Width="640" Height="640" ClipToBounds="True"/>
                </Viewbox>
                <Canvas x:Name="VaultCanvas" Width="640" Height="640" Background="Transparent" Visibility="Collapsed"/>
            </Grid>

            <Border Grid.Column="1" Background="#0D1215" BorderBrush="#3B4549" BorderThickness="1"
                    Padding="30" Margin="16,54,0,54">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.35"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="UMBRAL DE ACCESO" Foreground="#7F8D91" FontSize="11"/>
                    <TextBlock x:Name="GateTitle" Text="La cámara permanece sellada." FontFamily="Constantia"
                               FontSize="27" Foreground="#D0D6D5" TextWrapping="Wrap" Margin="0,12,0,8"/>
                    <TextBlock x:Name="GateDescription" Text="La autenticación local precede a cualquier movimiento del mecanismo."
                               Foreground="#899394" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="0,0,0,24"/>

                    <TextBlock Text="CLAVE MAESTRA" FontSize="10" Foreground="#9AA3A2" Margin="0,0,0,8"/>
                    <PasswordBox x:Name="MasterPasswordBox" Height="42"/>
                    <TextBlock x:Name="ConfirmLabel" Text="CONFIRMAR CLAVE MAESTRA" FontSize="10"
                               Foreground="#9AA3A2" Margin="0,18,0,8" Visibility="Collapsed"/>
                    <PasswordBox x:Name="ConfirmPasswordBox" Height="42" Visibility="Collapsed"/>

                    <TextBlock Text="VENTANA DE DESBLOQUEO" FontSize="10" Foreground="#9AA3A2" Margin="0,22,0,8"/>
                    <ComboBox x:Name="SessionDuration" Height="38" SelectedIndex="5">
                        <ComboBoxItem Content="15 segundos" Tag="15"/>
                        <ComboBoxItem Content="30 segundos" Tag="30"/>
                        <ComboBoxItem Content="1 minuto" Tag="60"/>
                        <ComboBoxItem Content="2 minutos" Tag="120"/>
                        <ComboBoxItem Content="3 minutos" Tag="180"/>
                        <ComboBoxItem Content="5 minutos · predeterminado" Tag="300"/>
                        <ComboBoxItem Content="10 minutos" Tag="600"/>
                        <ComboBoxItem Content="15 minutos" Tag="900"/>
                    </ComboBox>

                    <Button x:Name="UnlockButton" Content="DESBLOQUEAR LA CÁMARA"
                            Height="48" Margin="0,26,0,0" Background="#222C30" BorderBrush="#59686C"/>
                    <TextBlock x:Name="GateMessage" Text="ACCESO LOCAL · SIN SERVICIO REMOTO"
                               Foreground="#778080" FontSize="9"
                               TextAlignment="Center" Margin="0,18,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="OpenStage" Grid.Row="1" Margin="0,18,0,12" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="228"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0B1013" BorderBrush="#39403E" BorderThickness="1" Padding="20,22">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="INTERIOR" FontFamily="Constantia" FontSize="24" Foreground="#7F8D91"/>
                        <TextBlock Text="CÁMARA ACTIVA" FontSize="9" Foreground="#7B8585" Margin="0,4,0,20"/>
                        <Border Height="1" Background="#343F43" Margin="0,0,0,18"/>
                        <TextBlock Text="ESTADO DE SESIÓN" FontSize="9" Foreground="#879292"/>
                        <TextBlock x:Name="SessionRemaining" Text="05:00" FontFamily="Consolas"
                                   FontSize="30" Foreground="#A66D49" Margin="0,6,0,2"/>
                        <TextBlock x:Name="SessionExpiresAt" Text="Vencimiento absoluto"
                                   FontSize="10" Foreground="#777F80" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                        <Button x:Name="LockButton" Content="CERRAR LA BÓVEDA" Height="46"
                                Background="#252B2D" BorderBrush="#70533F"/>
                        <TextBlock Text="EL CIERRE LÓGICO PRECEDE AL MOVIMIENTO DE LA PUERTA."
                                   Foreground="#737D7D" FontSize="9" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel>
                        <Border Height="1" Background="#333B3D" Margin="0,0,0,18"/>
                        <TextBlock Text="SELLO" FontSize="9" Foreground="#7B8585"/>
                        <TextBlock Text="EP / LOCAL" FontFamily="Consolas" FontSize="12" Foreground="#7F8D91" Margin="0,5,0,18"/>
                        <TextBlock Text="POLÍTICA" FontSize="9" Foreground="#7B8585"/>
                        <TextBlock Text="MÍNIMO PRIVILEGIO" FontSize="11" Foreground="#C7C0B2" Margin="0,5,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" Margin="20,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="2,2,0,14">
                    <StackPanel>
                        <TextBlock Text="CÁMARA DE CUSTODIA" FontSize="10" Foreground="#7F8D91"/>
                        <TextBlock Text="Compartimentos y notas efímeras" FontFamily="Constantia"
                                   FontSize="24" Foreground="#E0D5C3" Margin="0,5,0,0"/>
                    </StackPanel>
                </StackPanel>

                <TabControl x:Name="VaultTabs" Grid.Row="1" Background="#0B1013" BorderBrush="#39403E">
                    <TabItem Header="VARIABLES FORMALES">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Nombre de variable" FontSize="10" Foreground="#879292" Margin="0,0,0,5"/>
                                    <TextBox x:Name="VariableNameBox" Width="330" HorizontalAlignment="Left" Height="38"/>
                                </StackPanel>
                                <Button x:Name="StoreVariableButton" Grid.Column="1" Content="GUARDAR PORTAPAPELES"
                                        Height="38" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
                            </Grid>

                            <ListView x:Name="VariableList" Grid.Row="1">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Nombre protegido" Width="380" DisplayMemberBinding="{Binding}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,14,0,0">
                                <Button x:Name="RefreshVariablesButton" Content="ACTUALIZAR" Margin="0,0,8,0"/>
                                <Button x:Name="RevealVariableButton" Content="REVELAR 15 S" Margin="0,0,8,0"/>
                                <Button x:Name="RemoveVariableButton" Content="RETIRAR" Background="#20282B" BorderBrush="#8D5C45"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="NOTAS EFÍMERAS">
                        <Grid Margin="18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Retención DPAPI" FontSize="10" Foreground="#879292" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="NoteTtl" Width="170" Height="36" SelectedIndex="1">
                                        <ComboBoxItem Content="15 minutos" Tag="15"/>
                                        <ComboBoxItem Content="30 minutos" Tag="30"/>
                                        <ComboBoxItem Content="1 hora" Tag="60"/>
                                        <ComboBoxItem Content="2 horas" Tag="120"/>
                                        <ComboBoxItem Content="4 horas" Tag="240"/>
                                    </ComboBox>
                                </StackPanel>
                                <Button x:Name="CaptureNoteButton" Content="CAPTURAR PORTAPAPELES"
                                        Height="36" VerticalAlignment="Bottom" Margin="12,0,0,0"/>
                            </StackPanel>
                            <ListView x:Name="NoteList" Grid.Row="1">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Identificador" Width="265" DisplayMemberBinding="{Binding id}"/>
                                        <GridViewColumn Header="Vence (UTC)" Width="205" DisplayMemberBinding="{Binding expiresAtUtc}"/>
                                        <GridViewColumn Header="Estado" Width="130" DisplayMemberBinding="{Binding status}"/>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            <Grid Grid.Row="2" Margin="0,14,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PromoteNameBox" Grid.Row="0" Grid.Column="0" Height="36"/>
                                <Button x:Name="PromoteNoteButton" Grid.Row="0" Grid.Column="1" Content="PROMOVER"
                                        Margin="10,0,0,0"/>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="RefreshNotesButton" Content="ACTUALIZAR" Margin="0,0,8,0"/>
                                    <Button x:Name="ReadNoteButton" Content="REVELAR NOTA 15 S" Margin="0,0,8,0"/>
                                    <Button x:Name="DeleteNoteButton" Content="ELIMINAR NOTA" Background="#20282B" BorderBrush="#8D5C45"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>

                <Border Grid.Row="2" BorderBrush="#353D3F" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="REVELACIÓN TEMPORAL" FontSize="9" Foreground="#7F8D91" VerticalAlignment="Center"/>
                        <TextBox x:Name="RevealedValueBox" Grid.Column="1" Margin="18,0,0,0" Height="36"
                                 IsReadOnly="True" Visibility="Collapsed" FontFamily="Consolas"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" BorderBrush="#30383B" BorderThickness="0,1,0,0" Padding="2,10,2,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterStatus" Text="LOCAL · CIFRADO · SELLADA"
                           FontSize="9" Foreground="#737D7D"/>
                <TextBlock Grid.Column="1" Text="EP / PRIVATE ENVIRONMENT VAULT"
                           FontSize="9" Foreground="#465053"/>
            </Grid>
        </Border>
    </Grid>
</Window>