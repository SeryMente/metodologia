{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SeryMente/metodologia/blob/main/frentes/mcp-metodologia/schemas/portable-recovery-package-v1.schema.json",
  "title": "OCP MCP Portable Recovery Package v1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "package_id",
    "created_at_utc",
    "installation_id",
    "source_operator_sid",
    "database_sha256",
    "kdf",
    "aead",
    "artifacts"
  ],
  "properties": {
    "format": {
      "const": "OCPMCP-PORTABLE-RECOVERY"
    },
    "format_version": {
      "const": 1
    },
    "package_id": {
      "type": "string",
      "format": "uuid"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "installation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_operator_sid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 184
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "app_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "database_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kdf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "version",
        "salt_base64",
        "memory_kib",
        "iterations",
        "parallelism",
        "output_bytes"
      ],
      "properties": {
        "algorithm": {
          "const": "Argon2id"
        },
        "version": {
          "const": 19
        },
        "salt_base64": {
          "type": "string",
          "minLength": 24,
          "maxLength": 24
        },
        "memory_kib": {
          "const": 65536
        },
        "iterations": {
          "const": 3
        },
        "parallelism": {
          "const": 1
        },
        "output_bytes": {
          "const": 32
        }
      }
    },
    "aead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_bytes",
        "nonce_bytes",
        "tag_bytes",
        "framing_magic"
      ],
      "properties": {
        "algorithm": {
          "const": "AES-256-GCM"
        },
        "key_bytes": {
          "const": 32
        },
        "nonce_bytes": {
          "const": 12
        },
        "tag_bytes": {
          "const": 16
        },
        "framing_magic": {
          "const": "PPR1"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot.sqlite.enc",
        "recovery-envelope.bin",
        "recovery-map.enc"
      ],
      "properties": {
        "snapshot.sqlite.enc": {
          "$ref": "#/$defs/artifact"
        },
        "recovery-envelope.bin": {
          "$ref": "#/$defs/artifact"
        },
        "recovery-map.enc": {
          "$ref": "#/$defs/artifact"
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "size_bytes",
        "sha256"
      ],
      "properties": {
        "size_bytes": {
          "type": "integer",
          "minimum": 33,
          "maximum": 1610612736
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
