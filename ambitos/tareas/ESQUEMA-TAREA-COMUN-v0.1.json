{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:serymente:task-contract:0.1",
  "title": "Tarea común Ser y Mente v0.1 (candidato)",
  "description": "Contrato mínimo reutilizable propuesto. No canonizado ni probado en producción.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "title",
    "status",
    "origin",
    "scope_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "status": {
      "type": "string",
      "enum": [
        "capturada",
        "por_definir",
        "definida",
        "lista",
        "en_curso",
        "bloqueada",
        "en_revision",
        "completada",
        "aplazada",
        "cancelada"
      ]
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "instruccion",
            "decision",
            "compromiso",
            "conversacion",
            "issue",
            "documento",
            "referencia_externa",
            "otro"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ]
        },
        "recorded_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "scope_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "frente",
            "ambito",
            "repositorio",
            "transversal",
            "pendiente"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "expected_outcome": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "status"
        ],
        "properties": {
          "criterion": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "pendiente",
              "cumplido",
              "no_cumplido",
              "no_verificable"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "owner": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "confirmado",
            "sin_asignar",
            "desconocido"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "priority": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "value",
        "scheme"
      ],
      "properties": {
        "value": {
          "type": [
            "string",
            "number"
          ]
        },
        "scheme": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "due_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "next_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "target"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "depende_de",
              "bloquea",
              "subtarea_de",
              "tiene_subtarea",
              "relacionada_con",
              "referencia"
            ]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": [
              "string",
              "null"
            ]
          },
          "resolution_action": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "verified_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "extensions": {
      "type": "object",
      "description": "Campos de perfil con espacios de nombres; no redefinir campos comunes.",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "definida",
              "lista",
              "en_curso",
              "bloqueada",
              "en_revision",
              "completada"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "expected_outcome",
          "acceptance_criteria"
        ],
        "properties": {
          "expected_outcome": {
            "type": "string",
            "minLength": 1
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "lista",
              "en_curso",
              "bloqueada"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "next_action"
        ],
        "properties": {
          "next_action": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "bloqueada"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "blockers"
        ],
        "properties": {
          "blockers": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completada"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "evidence_refs"
        ],
        "properties": {
          "evidence_refs": {
            "type": "array",
            "minItems": 1
          },
          "acceptance_criteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "cumplido"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        }
      }
    }
  ]
}
