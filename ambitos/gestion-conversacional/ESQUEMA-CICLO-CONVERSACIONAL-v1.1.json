{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registro conversacional A/B · FOL1 y legado pre-corte · v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "event_id",
    "conversation_id",
    "cycle_number",
    "side",
    "sequence_in_cycle",
    "speaker",
    "text",
    "repository_ref",
    "front_ref",
    "ocp_refs",
    "foliation_generation",
    "folio_status",
    "source_kind"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "minLength": 1,
      "description": "Identidad del registro A/B. En legado conserva literalmente el identificador C-...-E/S; en FOL1 es distinto del folio global y local."
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "conversation_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "conversation_folio_global": {
      "type": "string",
      "pattern": "^CV-G[0-9]{8}$"
    },
    "conversation_folios_by_ocp": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^CV-OCP-[A-Z0-9-]+-[0-9]{8}$"
      }
    },
    "cycle_number": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1,
      "description": "Número natural consecutivo dentro de la conversación; null solo cuando el antecedente no permite conocerlo sin inferencia."
    },
    "cycle_folio_global": {
      "type": "string",
      "pattern": "^CY-G[0-9]{8}$"
    },
    "cycle_folios_by_ocp": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^CY-OCP-[A-Z0-9-]+-[0-9]{8}$"
      }
    },
    "side": {
      "enum": [
        "A",
        "B"
      ]
    },
    "sequence_in_cycle": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "record_folio_global": {
      "type": "string",
      "pattern": "^(A|B)-G[0-9]{8}$"
    },
    "record_folios_by_ocp": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^(A|B)-OCP-[A-Z0-9-]+-[0-9]{8}$"
      }
    },
    "speaker": {
      "enum": [
        "operator",
        "assistant"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "Texto literal, sin correcciones ni normalización."
    },
    "repository_ref": {
      "type": "string",
      "minLength": 1
    },
    "front_ref": {
      "type": "string",
      "minLength": 1
    },
    "ocp_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "foliation_generation": {
      "enum": [
        "FOL1",
        "LEGACY"
      ]
    },
    "folio_status": {
      "enum": [
        "ASSIGNED_VERIFIED",
        "PARTIAL_OCP_COVERAGE",
        "PENDING",
        "LEGACY_PRE_CUTOVER"
      ]
    },
    "source_kind": {
      "enum": [
        "live_user_message",
        "visible_final_response"
      ]
    },
    "native_platform_conversation_id": {
      "type": "string"
    },
    "native_platform_message_id": {
      "type": "string"
    },
    "visible_auxiliary_outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sequence",
          "text"
        ],
        "properties": {
          "sequence": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "persisted_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "blob_sha"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "blob_sha": {
          "type": "string"
        }
      }
    },
    "legacy_cycle_folio": {
      "type": "string",
      "pattern": "^C-[0-9]{8}-[A-F0-9]{8}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "folio_status": {
            "const": "ASSIGNED_VERIFIED"
          }
        },
        "required": [
          "folio_status"
        ]
      },
      "then": {
        "required": [
          "cycle_number",
          "conversation_folio_global",
          "conversation_folios_by_ocp",
          "cycle_folio_global",
          "cycle_folios_by_ocp",
          "record_folio_global",
          "record_folios_by_ocp"
        ],
        "properties": {
          "cycle_number": {
            "type": "integer",
            "minimum": 1
          },
          "foliation_generation": {
            "const": "FOL1"
          }
        },
        "not": {
          "required": [
            "legacy_cycle_folio"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "folio_status": {
            "const": "PARTIAL_OCP_COVERAGE"
          }
        },
        "required": [
          "folio_status"
        ]
      },
      "then": {
        "required": [
          "cycle_number",
          "conversation_folio_global",
          "conversation_folios_by_ocp",
          "cycle_folio_global",
          "cycle_folios_by_ocp",
          "record_folio_global",
          "record_folios_by_ocp"
        ],
        "properties": {
          "cycle_number": {
            "type": "integer",
            "minimum": 1
          },
          "foliation_generation": {
            "const": "FOL1"
          },
          "conversation_folios_by_ocp": {
            "type": "object",
            "minProperties": 1
          },
          "cycle_folios_by_ocp": {
            "type": "object",
            "minProperties": 1
          },
          "record_folios_by_ocp": {
            "type": "object",
            "minProperties": 1
          }
        },
        "not": {
          "required": [
            "legacy_cycle_folio"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "folio_status": {
            "const": "PENDING"
          }
        },
        "required": [
          "folio_status"
        ]
      },
      "then": {
        "properties": {
          "foliation_generation": {
            "const": "FOL1"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "conversation_folio_global"
              ]
            },
            {
              "required": [
                "conversation_folios_by_ocp"
              ]
            },
            {
              "required": [
                "cycle_folio_global"
              ]
            },
            {
              "required": [
                "cycle_folios_by_ocp"
              ]
            },
            {
              "required": [
                "record_folio_global"
              ]
            },
            {
              "required": [
                "record_folios_by_ocp"
              ]
            },
            {
              "required": [
                "legacy_cycle_folio"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "folio_status": {
            "const": "LEGACY_PRE_CUTOVER"
          }
        },
        "required": [
          "folio_status"
        ]
      },
      "then": {
        "required": [
          "legacy_cycle_folio"
        ],
        "properties": {
          "foliation_generation": {
            "const": "LEGACY"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "conversation_folio_global"
              ]
            },
            {
              "required": [
                "conversation_folios_by_ocp"
              ]
            },
            {
              "required": [
                "cycle_folio_global"
              ]
            },
            {
              "required": [
                "cycle_folios_by_ocp"
              ]
            },
            {
              "required": [
                "record_folio_global"
              ]
            },
            {
              "required": [
                "record_folios_by_ocp"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "side": {
            "const": "A"
          }
        },
        "required": [
          "side"
        ]
      },
      "then": {
        "properties": {
          "sequence_in_cycle": {
            "const": 1
          },
          "speaker": {
            "const": "operator"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "side": {
            "const": "B"
          }
        },
        "required": [
          "side"
        ]
      },
      "then": {
        "properties": {
          "sequence_in_cycle": {
            "const": 2
          },
          "speaker": {
            "const": "assistant"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "side": {
            "const": "A"
          },
          "folio_status": {
            "enum": [
              "ASSIGNED_VERIFIED",
              "PARTIAL_OCP_COVERAGE"
            ]
          }
        },
        "required": [
          "side",
          "folio_status"
        ]
      },
      "then": {
        "properties": {
          "record_folio_global": {
            "pattern": "^A-G[0-9]{8}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "side": {
            "const": "B"
          },
          "folio_status": {
            "enum": [
              "ASSIGNED_VERIFIED",
              "PARTIAL_OCP_COVERAGE"
            ]
          }
        },
        "required": [
          "side",
          "folio_status"
        ]
      },
      "then": {
        "properties": {
          "record_folio_global": {
            "pattern": "^B-G[0-9]{8}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "side": {
            "const": "A"
          },
          "folio_status": {
            "const": "LEGACY_PRE_CUTOVER"
          }
        },
        "required": [
          "side",
          "folio_status"
        ]
      },
      "then": {
        "properties": {
          "record_id": {
            "pattern": "^C-[0-9]{8}-[A-F0-9]{8}-E$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "side": {
            "const": "B"
          },
          "folio_status": {
            "const": "LEGACY_PRE_CUTOVER"
          }
        },
        "required": [
          "side",
          "folio_status"
        ]
      },
      "then": {
        "properties": {
          "record_id": {
            "pattern": "^C-[0-9]{8}-[A-F0-9]{8}-S$"
          }
        }
      }
    }
  ],
  "$comment": "La cobertura por OCP y la correspondencia entre ocp_refs y los mapas de folios requieren validación semántica adicional; JSON Schema no demuestra exhaustividad del catálogo ni exclusividad de servidor."
}
